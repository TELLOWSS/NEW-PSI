NEXT_PUBLIC_SUPABASE_URL=your-supabase-url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
VITE_SUPABASE_URL=your-supabase-url
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

SUPABASE_SERVICE_ROLE_KEY=your-server-side-service-role-key
# 서버 OCR: 무료 키만 기본 실행하며, 유료 키는 문서별 명시 승인 요청에만 사용합니다.
GEMINI_API_KEY_FREE=your-free-tier-gemini-api-key
GEMINI_API_KEY_PAID=your-paid-tier-gemini-api-key
# OCR에서는 읽지 않으며, OCR 외 기존 서버 Gemini 기능과의 호환용으로 무료 키와 같은 값을 권장합니다.
GEMINI_API_KEY=your-free-tier-gemini-api-key
OCR_PAID_APPROVAL_SECRET=replace-with-long-random-paid-approval-secret
OCR_MAX_USD_PER_DOCUMENT=0.05
GOOGLE_TTS_API_KEY=your-google-tts-api-key

NEXT_PUBLIC_APP_BASE_URL=https://your-vercel-domain.vercel.app
TRAINING_LINK_SECRET=replace-with-long-random-training-link-secret
ADMIN_LOGIN_PASSWORD=replace-with-strong-admin-password
ADMIN_SESSION_SECRET=replace-with-long-random-session-secret
PSI_ADMIN_SECRET=replace-with-server-side-admin-secret

SOLAPI_API_KEY=your-solapi-api-key
SOLAPI_API_SECRET=your-solapi-api-secret
SOLAPI_SENDER=01012345678
